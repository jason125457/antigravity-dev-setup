{
  "project-hooks": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_file|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import sys; sys.exit(0)\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
